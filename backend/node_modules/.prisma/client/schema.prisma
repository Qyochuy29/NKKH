generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  ban_giam_hieu
  giam_thi
  bao_ve
}

enum DeviceStatus {
  online
  offline
  error
}

enum SoundType {
  scream
  help
  threat
  argument
}

enum AlertStatus {
  pending
  confirmed
  false_alarm
  resolved
}

model User {
  id            String   @id @default(uuid())
  full_name     String
  email         String   @unique
  password_hash String
  role          Role
  created_at    DateTime @default(now())

  handled_alerts Alert[]    @relation("HandledBy")
  alert_logs     AlertLog[]

  @@map("users")
}

model Device {
  id            String       @id @default(uuid())
  name          String
  area          String
  floor         Int
  position_x    Float
  position_y    Float
  status        DeviceStatus @default(online)
  battery_level Int          @default(100)
  last_seen     DateTime     @default(now())

  alerts Alert[]

  @@map("devices")
}

model Alert {
  id               String      @id @default(uuid())
  device_id        String
  timestamp        DateTime    @default(now())
  sound_type       SoundType
  confidence_score Float
  audio_file_url   String?
  status           AlertStatus @default(pending)
  handled_by_id    String?
  resolved_at      DateTime?
  notes            String?
  is_evidence      Boolean     @default(false)

  device     Device     @relation(fields: [device_id], references: [id])
  handled_by User?      @relation("HandledBy", fields: [handled_by_id], references: [id])
  logs       AlertLog[]

  @@index([timestamp])
  @@index([status])
  @@index([sound_type])
  @@index([device_id])
  @@map("alerts")
}

model AlertLog {
  id        String   @id @default(uuid())
  alert_id  String
  action    String
  actor_id  String
  timestamp DateTime @default(now())

  alert Alert @relation(fields: [alert_id], references: [id])
  actor User  @relation(fields: [actor_id], references: [id])

  @@index([alert_id])
  @@map("alert_logs")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
